# MySQL
MYSQL_HOST=change-me
MYSQL_PORT=3306
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=midsnap

# Optional login for the staff app. Leave empty for no login.
STAFF_USER=staff
STAFF_PASSWORD=

# ---- Customer download links (Cloudinary) -------------------------------------------------------
# The strip is uploaded as a high-quality PNG; the link works for SHARE_TTL_HOURS, then the file is deleted.
# Copy "API environment variable" from the Cloudinary dashboard (Settings > API Keys):
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ...or set the three values separately instead:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=midsnap
SHARE_TTL_HOURS=24
# Largest PNG to upload (Cloudinary's free plan allows 10 MB per image; bigger strips fall back to 300 dpi)
SHARE_MAX_MB=9.5

# ---- Printing ------------------------------------------------------------------------------------
# Browsers cannot choose the paper type or quality, so MIDSnap can print from the server instead, always as:
#   4 in x 6 in (North American) · Photo Paper, Glossy · High quality · Borderless
# auto    = use the server's printer when there is one (Windows, or CUPS with a default printer)
# cups    = Linux / macOS through `lp`        windows = Windows through pywin32
# browser = never print from the server (the browser's print dialog is used instead)
PRINT_BACKEND=auto
# Leave empty for the system default printer
PRINTER_NAME=
# Only if your driver uses other CUPS option names (see `lpoptions -p PRINTER -l`):
# CUPS_MEDIA=na_index-4x6_4x6in
# CUPS_MEDIA_TYPE=photographic-glossy
# CUPS_QUALITY=5
# CUPS_BORDERLESS_OPTIONS=Borderless=True print-scaling=fill
