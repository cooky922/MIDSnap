# MySQL
MYSQL_HOST=change-me
MYSQL_PORT=3306
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=midsnap

# Optional login for the staff app. Leave empty for no login.
STAFF_USER=staff
STAFF_PASSWORD=

# ---- Customer download links (Cloudinary) -------------------------------------------------------
# The strip is uploaded as a high-quality PNG; the link works for SHARE_TTL_HOURS, then the file is deleted.
# Copy "API environment variable" from the Cloudinary dashboard (Settings > API Keys):
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ...or set the three values separately instead:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=midsnap
SHARE_TTL_HOURS=24
# Largest PNG to upload (Cloudinary's free plan allows 10 MB per image; bigger strips fall back to 300 dpi)
SHARE_MAX_MB=9.5
