# MySQL
MYSQL_HOST=change-me
MYSQL_PORT=change-me
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=midsnap

# The address customers' phones can open (used inside the QR codes). No trailing slash.
# Must be reachable from the customer's phone, e.g. https://photos.example.com or http://192.168.1.20:5000
PUBLIC_BASE_URL=

# Optional login for the staff app (the customer links /s/... never need it). Leave empty for no login.
STAFF_USER=staff
STAFF_PASSWORD=

# How long a customer download link works, in hours (default: 1 day)
SHARE_TTL_HOURS=24
